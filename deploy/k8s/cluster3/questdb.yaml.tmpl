apiVersion: v1
kind: ConfigMap
metadata:
  name: questdb-config
  namespace: ${NAMESPACE}
  labels:
    app: questdb
data:
  server.conf: |
    # QuestDB server configuration for K8s test clusters.
    http.enabled=true
    http.bind.to=0.0.0.0:9000

    pg.enabled=true
    pg.bind.to=0.0.0.0:8812

    influxdb.enabled=true
    influxdb.bind.to=0.0.0.0:9009

    # Keep resource usage modest by default (override via pod resources if needed).
    shared.worker.count=4
    shared.worker.affinity=on
    shared.worker.haltOnError=false

    cairo.default.partition.by=DAY
    cairo.max.uncommitted.rows=500000
    cairo.commit.lag=240000
    cairo.max.lag=300000

    log.level=INFO

---
apiVersion: v1
kind: Service
metadata:
  name: questdb-service
  namespace: ${NAMESPACE}
  labels:
    app: questdb
spec:
  type: ClusterIP
  ports:
  - port: 9000
    targetPort: 9000
    protocol: TCP
    name: http
  - port: 8812
    targetPort: 8812
    protocol: TCP
    name: postgres
  - port: 9009
    targetPort: 9009
    protocol: TCP
    name: influxdb
  selector:
    app: questdb

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: questdb-data
  namespace: ${NAMESPACE}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: ${QUESTDB_STORAGE_SIZE}
  storageClassName: ${QUESTDB_STORAGE_CLASS}

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: questdb
  namespace: ${NAMESPACE}
  labels:
    app: questdb
spec:
  replicas: 1
  selector:
    matchLabels:
      app: questdb
  template:
    metadata:
      labels:
        app: questdb
    spec:
      containers:
      - name: questdb
        image: questdb/questdb:7.3.4
        ports:
        - containerPort: 9000
          name: http
        - containerPort: 8812
          name: postgres
        - containerPort: 9009
          name: influxdb
        volumeMounts:
        - name: config-volume
          mountPath: /var/lib/questdb/conf/server.conf
          subPath: server.conf
        - name: data-volume
          mountPath: /var/lib/questdb/db
        - name: log-volume
          mountPath: /var/lib/questdb/log
        resources:
          requests:
            memory: "512Mi"
            cpu: "250m"
          limits:
            memory: "2Gi"
            cpu: "1000m"
        livenessProbe:
          httpGet:
            path: /status
            port: 9000
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /status
            port: 9000
          initialDelaySeconds: 5
          periodSeconds: 5
      volumes:
      - name: config-volume
        configMap:
          name: questdb-config
      - name: data-volume
        persistentVolumeClaim:
          claimName: questdb-data
      - name: log-volume
        emptyDir: {}





